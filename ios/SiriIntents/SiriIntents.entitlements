<?xml version="1.0" encoding="UTF-8"?>
<!--
  ios/SiriIntents/SiriIntents.entitlements
  
  The Intents Extension target must share the SAME App Group ID as the
  main Runner target. This is how AskPintSizeAiIntent reads questions from
  and writes answers to the shared UserDefaults container.
  
  In Xcode: SiriIntents target → Signing & Capabilities → App Groups
  Add: group.com.pintsizeai.app
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.pintsizeai.app</string>
  </array>

</dict>
</plist>
